{
  "name": "@atlasbi/api-gateway",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir test/unit",
    "test:integration": "vitest run --dir test/integration --test-timeout 120000 --hook-timeout 120000",
    "test:image": "vitest run --dir test/image --test-timeout 120000 --hook-timeout 120000",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "dev": "node --env-file-if-exists=../../.env --watch src/main.ts"
  },
  "dependencies": {
    "@atlasbi/auth": "workspace:*",
    "@atlasbi/config": "workspace:*",
    "@atlasbi/contracts": "workspace:*",
    "@atlasbi/reports": "workspace:*",
    "@atlasbi/semantic": "workspace:*",
    "@fastify/helmet": "catalog:",
    "@fastify/otel": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/instrumentation-pg": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@trpc/server": "catalog:",
    "fastify": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@atlasbi/database": "workspace:*",
    "@trpc/client": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
