# AtlasBI — local development configuration ("equipo local mínimo").
#
# `pnpm bootstrap` copies this file to .env (it never overwrites an existing .env).
# Processes validate it at startup and refuse to start with a clear message if something
# required is missing (docs/19-operabilidad-runtime.md §7).
#
# Secrets are resolved through the SecretProvider port. In development the adapter is
# EnvSecretProvider, which maps a logical key to a variable: `database.url` → ATLASBI_DATABASE_URL.

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------

# development | test | production
ATLASBI_ENV=development

# SecretProvider adapter. Only `env` exists until OpenBao arrives (build step 14).
ATLASBI_SECRET_PROVIDER=env

# ---------------------------------------------------------------------------
# Local Postgres container (compose.yaml)
# ---------------------------------------------------------------------------

ATLASBI_POSTGRES_USER=atlasbi
ATLASBI_POSTGRES_PASSWORD=atlasbi-dev-only
ATLASBI_POSTGRES_DB=atlasbi

# Host port, published on 127.0.0.1 only. Not 5432, so a Postgres already installed on the
# machine does not collide with it. If you change it, change ATLASBI_DATABASE_URL too.
ATLASBI_POSTGRES_PORT=55432

# ---------------------------------------------------------------------------
# Secrets — one variable per logical key
# ---------------------------------------------------------------------------

# database.url — the platform control-plane database (migrations, and later auth/reports).
ATLASBI_DATABASE_URL=postgres://atlasbi:atlasbi-dev-only@127.0.0.1:55432/atlasbi

# lakehouse.catalog-url — the PostgreSQL catalog of the lakehouse (only with catalog type postgres).
# A separate database on the same local server; `pnpm bootstrap` creates it. Plain postgres:// URL:
# query parameters (e.g. sslmode) are rejected rather than silently ignored.
ATLASBI_LAKEHOUSE_CATALOG_URL=postgres://atlasbi:atlasbi-dev-only@127.0.0.1:55432/lakehouse

# lakehouse.catalog-reader-url — the same catalog through a SELECT-only role, for the readers (the
# query port and Cube). `pnpm bootstrap` creates the role with this user and password.
ATLASBI_LAKEHOUSE_CATALOG_READER_URL=postgres://lakehouse_reader:atlasbi-dev-only-reader@127.0.0.1:55432/lakehouse

# lakehouse.s3-writer-* / lakehouse.s3-reader-* — keys of the object storage (PostgreSQL catalog
# only). The writer owns the bucket (platform admin port, seed, SQLMesh); the reader can only read
# it (query port, Cube). Garage wants "GK" + 24 hex digits and a 64-hex-digit secret.
# Development-only values, like the Postgres password above — never use them outside this machine.
ATLASBI_LAKEHOUSE_S3_WRITER_ACCESS_KEY_ID=GKa71a5b1dde70000000000001
ATLASBI_LAKEHOUSE_S3_WRITER_SECRET_ACCESS_KEY=a71a5b1dde700000000000000000000000000000000000000000000000000001
ATLASBI_LAKEHOUSE_S3_READER_ACCESS_KEY_ID=GKa71a5b1dde70000000000002
ATLASBI_LAKEHOUSE_S3_READER_SECRET_ACCESS_KEY=a71a5b1dde700000000000000000000000000000000000000000000000000002

# object-storage.admin-token / object-storage.rpc-secret — administration of the local object
# storage server (compose.yaml). Only `pnpm bootstrap` uses the admin token (to create the reader
# key); the RPC secret is for the server alone. Development-only values.
ATLASBI_OBJECT_STORAGE_ADMIN_TOKEN=atlasbi-dev-only-object-storage-admin
ATLASBI_OBJECT_STORAGE_RPC_SECRET=a71a5b1dde700000000000000000000000000000000000000000000000000003

# semantic.api-secret — the secret Cube (the semantic layer, postgres tier) verifies the platform's
# short-lived query tokens with. semantic.sql-password — password of Cube's SQL API (PostgreSQL wire
# protocol) for its user `semantic`. Development-only values.
ATLASBI_SEMANTIC_API_SECRET=a71a5b1dde700000000000000000000000000000000000000000000000000004
ATLASBI_SEMANTIC_SQL_PASSWORD=atlasbi-dev-only-semantic-sql

# transform.state-url — SQLMesh's state database (build step 2): which models, plans and intervals
# exist. A separate database on the same local server; `pnpm bootstrap` creates it. Only
# `pnpm bootstrap` and `pnpm transform` need it.
ATLASBI_TRANSFORM_STATE_URL=postgres://atlasbi:atlasbi-dev-only@127.0.0.1:55432/sqlmesh_state

# ---------------------------------------------------------------------------
# Lakehouse — DuckDB + DuckLake (docs/01 §6.6–6.7)
# ---------------------------------------------------------------------------

# The catalog type picks the deployment tier, and with it where the Parquet data files live:
#   postgres (default) — "equipo local" and cloud: several processes may write at once, and the data
#                        files live in S3-compatible object storage (docs/11 §4.4). Needs the
#                        lakehouse.catalog-url and lakehouse.s3-* secrets above.
#   sqlite             — portable: a single writing process (docs/01 §6.6), data files in a folder.
# A DuckDB-file catalog is not supported: it allows a single client only.
ATLASBI_LAKEHOUSE_CATALOG_TYPE=postgres

# S3 data path and endpoint (postgres catalog). The URL is the same for every process — on the host
# or in a container; only the endpoint changes. The catalog records the URL at provisioning;
# changing it later is refused, never silently applied.
# ATLASBI_LAKEHOUSE_S3_URL=s3://lakehouse/data/
# ATLASBI_LAKEHOUSE_S3_ENDPOINT=127.0.0.1:53900
# ATLASBI_LAKEHOUSE_S3_REGION=garage
# ATLASBI_LAKEHOUSE_S3_USE_SSL=false

# Host ports of the local object storage (S3 API and admin API), published on 127.0.0.1 only.
# If you change the S3 port, change ATLASBI_LAKEHOUSE_S3_ENDPOINT too.
ATLASBI_OBJECT_STORAGE_PORT=53900
ATLASBI_OBJECT_STORAGE_ADMIN_PORT=53903

# Host ports of Cube, published on 127.0.0.1 only: its REST API, and its SQL API (PostgreSQL wire
# protocol). The browser never talks to Cube; the platform does (docs/19 §10).
ATLASBI_CUBE_PORT=4000
ATLASBI_CUBE_SQL_PORT=15432

# Data folder of the portable tier (sqlite catalog). Default: .data/lakehouse/sqlite/files.
# ATLASBI_LAKEHOUSE_DATA_PATH=

# SQLite catalog file (only with ATLASBI_LAKEHOUSE_CATALOG_TYPE=sqlite).
# ATLASBI_LAKEHOUSE_SQLITE_PATH=.data/lakehouse/sqlite/catalog.sqlite

# DuckDB extensions. `pnpm bootstrap` installs them here (the only download); at runtime they are
# only loaded, never downloaded. Relative paths resolve against the repository root.
# ATLASBI_DUCKDB_EXTENSION_DIRECTORY=.data/duckdb/extensions

# ---------------------------------------------------------------------------
# Telemetry — OpenTelemetry standard variables, read by every instrumented process
# ---------------------------------------------------------------------------

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Host ports of the local OTel Collector (OTLP gRPC, OTLP HTTP, health check).
ATLASBI_OTEL_GRPC_PORT=4317
ATLASBI_OTEL_HTTP_PORT=4318
ATLASBI_OTEL_HEALTH_PORT=13133

# ---------------------------------------------------------------------------
# Container tooling (optional)
# ---------------------------------------------------------------------------

# Full path of the standalone docker-compose used by `podman compose`. Leave it unset: the platform
# CLI finds it on PATH and skips Docker Desktop's copies. Set it here only if the standalone is not
# on PATH. It applies to this repo's commands only — never set PODMAN_COMPOSE_PROVIDER globally.
# ATLASBI_COMPOSE_PROVIDER=
