# AtlasBI — local development configuration ("equipo local mínimo").
#
# `pnpm bootstrap` copies this file to .env (it never overwrites an existing .env).
# Processes validate it at startup and refuse to start with a clear message if something
# required is missing (docs/19-operabilidad-runtime.md §7).
#
# Secrets are resolved through the SecretProvider port. In development the adapter is
# EnvSecretProvider, which maps a logical key to a variable: `database.url` → ATLASBI_DATABASE_URL.

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------

# development | test | production
ATLASBI_ENV=development

# SecretProvider adapter. Only `env` exists until OpenBao arrives (build step 14).
ATLASBI_SECRET_PROVIDER=env

# ---------------------------------------------------------------------------
# Local Postgres container (compose.yaml)
# ---------------------------------------------------------------------------

ATLASBI_POSTGRES_USER=atlasbi
ATLASBI_POSTGRES_PASSWORD=atlasbi-dev-only
ATLASBI_POSTGRES_DB=atlasbi

# Host port, published on 127.0.0.1 only. Not 5432, so a Postgres already installed on the
# machine does not collide with it. If you change it, change ATLASBI_DATABASE_URL too.
ATLASBI_POSTGRES_PORT=55432

# ---------------------------------------------------------------------------
# Secrets — one variable per logical key
# ---------------------------------------------------------------------------

# database.url — the platform control-plane database (migrations, and later auth/reports).
ATLASBI_DATABASE_URL=postgres://atlasbi:atlasbi-dev-only@127.0.0.1:55432/atlasbi

# ---------------------------------------------------------------------------
# Telemetry — OpenTelemetry standard variables, read by every instrumented process
# ---------------------------------------------------------------------------

OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Host ports of the local OTel Collector (OTLP gRPC, OTLP HTTP, health check).
ATLASBI_OTEL_GRPC_PORT=4317
ATLASBI_OTEL_HTTP_PORT=4318
ATLASBI_OTEL_HEALTH_PORT=13133

# ---------------------------------------------------------------------------
# Container tooling (optional)
# ---------------------------------------------------------------------------

# Full path of the standalone docker-compose used by `podman compose`. Leave it unset: the platform
# CLI finds it on PATH and skips Docker Desktop's copies. Set it here only if the standalone is not
# on PATH. It applies to this repo's commands only — never set PODMAN_COMPOSE_PROVIDER globally.
# ATLASBI_COMPOSE_PROVIDER=
